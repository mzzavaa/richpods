{
    "name": "@richpods/generative-ai-tools",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "build/index.js",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.5.0"
    },
    "scripts": {
        "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=build/index.js --external:@google-cloud/firestore --external:@google-cloud/functions-framework --external:@google-cloud/speech --external:@google-cloud/storage --external:@google/genai --external:got --external:joi --external:uuid",
        "clean": "rimraf build",
        "dev": "npm run build && set -a; . ./.env.development; set +a; npx @google-cloud/functions-framework --target=generativeAiTools --signature-type=http --port=8082",
        "start": "npx @google-cloud/functions-framework --target=generativeAiTools --signature-type=http"
    },
    "dependencies": {
        "@google-cloud/firestore": "8.7.1",
        "@google-cloud/functions-framework": "5.0.5",
        "@google-cloud/speech": "7.5.0",
        "@google-cloud/storage": "7.22.0",
        "@google/genai": "2.30.0",
        "got": "15.1.0",
        "joi": "18.3.0",
        "uuid": "13.0.2"
    },
    "devDependencies": {
        "@richpods/shared": "workspace:*",
        "@tsconfig/node24": "24.0.5",
        "@types/node": "25.9.9",
        "esbuild": "0.28.2",
        "rimraf": "6.1.3",
        "typescript": "6.0.3"
    }
}
